    {
      "name": "Create Employees",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response is JSON\", function () {\r\n    pm.response.to.be.json;\r\n});\r\n\r\npm.test(\"Employee was created\", function () {\r\n    const response = pm.response.json();\r\n\r\n    pm.expect(response).to.be.an(\"array\");\r\n    pm.expect(response.length).to.be.greaterThan(0);\r\n\r\n    const employee = response[0];\r\n\r\n    pm.expect(employee.firstName).to.eql(\"John\");\r\n    pm.expect(employee.paternalLastName).to.eql(\"Smith\");\r\n    pm.expect(employee.position).to.eql(\"Software Engineer\");\r\n    pm.expect(employee.active).to.eql(true);\r\n});\r\n\r\npm.test(\"Employee has generated id\", function () {\r\n    const employee = pm.response.json()[0];\r\n\r\n    pm.expect(employee.id).to.exist;\r\n    pm.expect(employee.id).to.be.a(\"number\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "[\r\n  {\r\n    \"firstName\": \"John\",\r\n    \"middleName\": \"Michael\",\r\n    \"paternalLastName\": \"Smith\",\r\n    \"maternalLastName\": \"Brown\",\r\n    \"age\": 35,\r\n    \"gender\": \"MALE\",\r\n    \"birthDate\": \"10-05-1991\",\r\n    \"position\": \"Software Engineer\",\r\n    \"active\": true\r\n  }\r\n]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "employees"
          ]
        }
      },
      "response": []
    },
