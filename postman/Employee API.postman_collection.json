    {
      "name": "Update Employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Position was updated\", function () {\r\n    const employee = pm.response.json();\r\n\r\n    pm.expect(employee.position)\r\n        .to.eql(\"Technical Lead\");\r\n});\r\n\r\npm.test(\"Employee id did not change\", function () {\r\n    const employee = pm.response.json();\r\n\r\n    pm.expect(employee.id)\r\n        .to.eql(Number(pm.collectionVariables.get(\"employeeId\")));\r\n});\r\n\r\npm.test(\"Unmodified fields remain unchanged\", function () {\r\n    const employee = pm.response.json();\r\n\r\n    pm.expect(employee.firstName).to.eql(\"John\");\r\n    pm.expect(employee.paternalLastName).to.eql(\"Smith\");\r\n});"
            ]
          }
        }
      ],
